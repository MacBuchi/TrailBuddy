<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ab Android 12 zeichnet das System den Startschirm selbst: Grund der
         App statt Weiß/Schwarz, darauf das App-Symbol. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
