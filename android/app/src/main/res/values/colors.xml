<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Hintergrund des adaptiven App-Symbols: die Marke, Lime (AppColors.brand). -->
    <color name="ic_launcher_background">#B6F04A</color>
    <!-- Tönung des Push-Symbols: die Marke auf Hell (MapPalette.light.mine).
         Lime selbst wäre auf der hellen Benachrichtigungsleiste unlesbar. -->
    <color name="notification_color">#4F8A10</color>
    <!-- Grund der App (AppColors.light.ground / .dark.ground): das
         Startfenster, bevor Flutter das erste Bild zeichnet. -->
    <color name="ground">#F3F2EC</color>
    <!-- Das Zeichen auf dem Startschirm ab Android 12 (drawable/ic_splash.xml):
         die Marke des Modus (AppPalette.brandMark) — Moos im Hellen. -->
    <color name="brand_mark">#4F8A10</color>
</resources>
