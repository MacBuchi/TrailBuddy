<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ab Android 12 zeichnet das System den Startschirm selbst: Grund der
         App statt Weiß/Schwarz, darauf das Zeichen in der Marke des Modus
         (ohne Lime-Scheibe) — wie der Splash der App, der danach übernimmt. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
